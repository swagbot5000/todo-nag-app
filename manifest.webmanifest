{
  "name": "To do",
  "short_name": "To do",
  "description": "Devan and Sarah's shared to-do list",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF1F4",
  "theme_color": "#24406B",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add task", "short_name": "Add", "url": "./?add=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
